# Copy to .env (gitignored). Never commit real values.
DATABASE_URL=postgres://localhost:5432/distribution
STORAGE_DRIVER=local
# Relative paths resolve against the workspace root for both web and worker.
# Packaged deployments must use the same absolute persistent mount in both services.
STORAGE_ROOT=./storage
APP_SECRET=            # 64 hex chars; signs sessions and encrypts Postiz keys
APP_PASSWORD=          # bootstraps the owner workspace on a fresh install only; afterwards everyone signs in with their own password
APP_ACCOUNT_NAME=Founder
SIGNUPS=open           # "closed" turns off self-serve sign-up (invite only)
LOG_LEVEL=info

# binaries
PYTHON_BIN=python3     # interpreter with vendor/autoshorts-py/requirements.txt installed
TTS_PROVIDER=openrouter # openrouter (Thalia) | openai (Coral); female synthetic outro voice
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
YTDLP_BIN=yt-dlp

# providers (any subset). Keys are read server-side only.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_OAUTH_TOKEN=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
PEXELS_API_KEY=
POSTIZ_API_KEY=         # used by the owner workspace only; other workspaces connect their own Postiz key
POSTIZ_API_URL=https://api.postiz.com/public/v1
POSTIZ_ALLOWED_HOSTS=   # comma separated hosts for self-hosted Postiz; api.postiz.com is always allowed

# routing: purpose → "provider:model,provider:model" fallback chain
LLM_RANK=openrouter:anthropic/claude-sonnet-4.5,deepseek:deepseek-chat
LLM_COPY=openrouter:google/gemini-2.5-flash
LLM_TITLE=openrouter:google/gemini-2.5-flash-lite
LLM_STORYBOARD=openrouter:anthropic/claude-sonnet-4.5
LLM_VISION=openrouter:google/gemini-2.5-flash
STT_PROVIDER=whisper-local   # deepgram | whisper-api | whisper-local
WHISPER_MODEL=base

# limits
DEFAULT_PRODUCT_MONTHLY_USD=25
DEFAULT_ACCOUNT_MONTHLY_USD=10   # AI spend cap per signed-up workspace per month; owner workspace is uncapped unless a limits row says otherwise
WORKER_MEDIA_CONCURRENCY=2
WORKER_LLM_CONCURRENCY=4
WORKER_RENDER_CONCURRENCY=1
WORKER_PUBLISH_CONCURRENCY=1

# Mandatory original-source screening (isolated Python 3.11 runtime).
# uv venv --python python3.11 .venv-screen
# uv pip install --python .venv-screen/bin/python -r vendor/screening/requirements.txt
# python3 scripts/setup-screening.py
# SCREENING_PYTHON_BIN=/absolute/path/to/.venv-screen/bin/python
# SCREENING_MODEL_DIR=/absolute/path/to/music-model-cache
# SCREENING_VISUAL_MODEL_DIR=/absolute/path/to/visual-model-cache

SCREENING_CV_THREADS=2 # measured CPU setting; full frame coverage is preserved
