{
  "name": "distribution",
  "private": true,
  "version": "0.0.0",
  "description": "Unified distribution platform: one product profile → promo films, short-form clips, thumbnails, copy, and scheduled publishing through Postiz.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@remotion/compositor-darwin-arm64",
      "@remotion/compositor-linux-x64-gnu",
      "@remotion/compositor-linux-arm64-gnu"
    ]
  },
  "type": "module"
}
